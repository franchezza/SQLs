-- =========================================================================
-- STEP 5C: DOWNGRADES FROM PROVISIONAL
-- No changes in this step
-- =========================================================================
CREATE OR REPLACE TABLE DEPT_410_PPM_AP_WORKSPACE_DB.FDLT.FREE_TO_PROV_DOWNGRADES2 AS
SELECT
    PC.USER_ID,
    PC.USER_UID,
    PC.CAMPAIGN_ID,
    PC.START_DATE,
    MIN(UTC.CHANGE_DATE) AS DOWNGRADE_DATE,
    DATEDIFF(DAY, PC.PROVISIONAL_DATE, MIN(UTC.CHANGE_DATE)) AS DAYS_FROM_PROV_TO_DOWNGRADE
FROM DEPT_410_PPM_AP_WORKSPACE_DB.FDLT.FREE_TO_PROV_PROVISIONAL_CONVERSIONS2 PC
INNER JOIN DEPT_410_PPM_AP_WORKSPACE_DB.FDLT.FREE_TO_PROV_USER_TYPE_CHANGES2 UTC
    ON PC.USER_ID = UTC.USER_ID
    AND PC.CAMPAIGN_ID = UTC.CAMPAIGN_ID
    AND PC.START_DATE = UTC.START_DATE
WHERE
    UTC.CHANGE_DATE > PC.PROVISIONAL_DATE
    AND UTC.CHANGE_DATE <= DATEADD(DAY, 30, PC.PROVISIONAL_DATE)
    AND UTC.NEW_USER_TYPE IN ('Guest', 'Viewer', 'Unlicensed', 'No Access', 'Ghost')
GROUP BY 1, 2, 3, 4, PC.PROVISIONAL_DATE;


-- =========================================================================
-- STEP 5D: IDENTIFY ACTION THAT TRIGGERED PROVISIONAL CONVERSION
-- CHANGE 3: Campaign-specific trigger action logic
-- CHANGE 4: Feature names updated with confirmed names from validation
--
-- Campaign 55646 (Comment Test):
--   Tracks 'Create Container Comment New' and 'Create Container Comment Reply'
--   These are the ONLY two comment feature names confirmed in the data
--   Expected result: Trigger Action Rate close to 100%
--
-- Campaign 55647 (Create Test):
--   Tracks 21 confirmed Create feature names from USER_FEATURE_USAGE_DAILY
--   Multiple qualifying actions exist — rate expected high but not 100%
--   Excludes comment actions that appeared in 55647 activity data
--
-- Window: email send date (exclusive) to Provisional date (inclusive)
-- Direct-to-Member users naturally excluded — not in Provisional table
-- Same-day creates (FOR_DATE = PROVISIONAL_DATE) are INCLUDED via <=
-- Validated: 2,271 users created Before, 33 Same Day, 537 After (excluded)
-- =========================================================================
CREATE OR REPLACE TABLE DEPT_410_PPM_AP_WORKSPACE_DB.FDLT.FREE_TO_PROV_TRIGGER_ACTION2 AS
SELECT
    PC.USER_ID,
    PC.USER_UID,
    PC.CAMPAIGN_ID,
    PC.START_DATE,
    PC.PROVISIONAL_DATE,

    -- First qualifying action date per campaign rule
    MIN(
        CASE
            WHEN PC.CAMPAIGN_ID = 55646
                AND E.FEATURE_NAME IN (
                    'Create Container Comment New',
                    'Create Container Comment Reply'
                )
            THEN E.FOR_DATE
            WHEN PC.CAMPAIGN_ID = 55647
                AND E.FEATURE_NAME IN (
                    'Create Sheet',
                    'Create Workspace',
                    'Create Notification Workflow',
                    'Create Any Workflow',
                    'Create Any Workflow Excluding Tooltip',
                    'Create Dashboard',
                    'Create Report',
                    'Create Folder',
                    'Create Form',
                    'Create Chart Widget',
                    'Create Metric Widget',
                    'Create Title Widget',
                    'Create Shortcut Widget',
                    'Create Grid Gantt Widget',
                    'Create Rich Text Widget',
                    'Create Image Widget',
                    'Create Change Cell Workflow',
                    'Create Clear Cell Workflow',
                    'Create Move Row Workflow',
                    'Create Reminder Workflow',
                    'Create Conditional Formatting Rule'
                )
            THEN E.FOR_DATE
        END
    ) AS TRIGGER_ACTION_DATE,

    -- Days from email send to first qualifying action
    DATEDIFF(DAY, PC.START_DATE,
        MIN(
            CASE
                WHEN PC.CAMPAIGN_ID = 55646
                    AND E.FEATURE_NAME IN (
                        'Create Container Comment New',
                        'Create Container Comment Reply'
                    )
                THEN E.FOR_DATE
                WHEN PC.CAMPAIGN_ID = 55647
                    AND E.FEATURE_NAME IN (
                        'Create Sheet',
                        'Create Workspace',
                        'Create Notification Workflow',
                        'Create Any Workflow',
                        'Create Any Workflow Excluding Tooltip',
                        'Create Dashboard',
                        'Create Report',
                        'Create Folder',
                        'Create Form',
                        'Create Chart Widget',
                        'Create Metric Widget',
                        'Create Title Widget',
                        'Create Shortcut Widget',
                        'Create Grid Gantt Widget',
                        'Create Rich Text Widget',
                        'Create Image Widget',
                        'Create Change Cell Workflow',
                        'Create Clear Cell Workflow',
                        'Create Move Row Workflow',
                        'Create Reminder Workflow',
                        'Create Conditional Formatting Rule'
                    )
                THEN E.FOR_DATE
            END
        )
    ) AS DAYS_TO_TRIGGER_ACTION,

    -- Label the trigger action type for reporting clarity
    CASE
        WHEN PC.CAMPAIGN_ID = 55646 THEN 'Comment'
        WHEN PC.CAMPAIGN_ID = 55647 THEN 'Create'
    END AS TRIGGER_ACTION_TYPE,

    -- 1 if the user took the qualifying action before or on conversion date
    -- 0 if no qualifying action found in the window
    CASE
        WHEN MIN(
            CASE
                WHEN PC.CAMPAIGN_ID = 55646
                    AND E.FEATURE_NAME IN (
                        'Create Container Comment New',
                        'Create Container Comment Reply'
                    )
                THEN E.FOR_DATE
                WHEN PC.CAMPAIGN_ID = 55647
                    AND E.FEATURE_NAME IN (
                        'Create Sheet',
                        'Create Workspace',
                        'Create Notification Workflow',
                        'Create Any Workflow',
                        'Create Any Workflow Excluding Tooltip',
                        'Create Dashboard',
                        'Create Report',
                        'Create Folder',
                        'Create Form',
                        'Create Chart Widget',
                        'Create Metric Widget',
                        'Create Title Widget',
                        'Create Shortcut Widget',
                        'Create Grid Gantt Widget',
                        'Create Rich Text Widget',
                        'Create Image Widget',
                        'Create Change Cell Workflow',
                        'Create Clear Cell Workflow',
                        'Create Move Row Workflow',
                        'Create Reminder Workflow',
                        'Create Conditional Formatting Rule'
                    )
                THEN E.FOR_DATE
            END
        ) IS NOT NULL THEN 1
        ELSE 0
    END AS HAD_TRIGGER_ACTION

FROM DEPT_410_PPM_AP_WORKSPACE_DB.FDLT.FREE_TO_PROV_PROVISIONAL_CONVERSIONS2 PC
LEFT JOIN USAGE.USER_FEATURE_USAGE_DAILY E
    ON PC.USER_ID = E.USER_ID
    -- Window: after email send up to and including Provisional date
    AND E.FOR_DATE > DATE(PC.START_DATE)
    AND E.FOR_DATE <= DATE(PC.PROVISIONAL_DATE)
    AND E.COUNT_ALL_SOURCES > 0
    -- Only join relevant actions per campaign to keep the join efficient
    AND (
        (PC.CAMPAIGN_ID = 55646
            AND E.FEATURE_NAME IN (
                'Create Container Comment New',
                'Create Container Comment Reply'
            )
        )
        OR
        (PC.CAMPAIGN_ID = 55647
            AND E.FEATURE_NAME IN (
                'Create Sheet',
                'Create Workspace',
                'Create Notification Workflow',
                'Create Any Workflow',
                'Create Any Workflow Excluding Tooltip',
                'Create Dashboard',
                'Create Report',
                'Create Folder',
                'Create Form',
                'Create Chart Widget',
                'Create Metric Widget',
                'Create Title Widget',
                'Create Shortcut Widget',
                'Create Grid Gantt Widget',
                'Create Rich Text Widget',
                'Create Image Widget',
                'Create Change Cell Workflow',
                'Create Clear Cell Workflow',
                'Create Move Row Workflow',
                'Create Reminder Workflow',
                'Create Conditional Formatting Rule'
            )
        )
    )
GROUP BY 1, 2, 3, 4, 5;


-- =========================================================================
-- STEP 6: TRACK ACTIVITY/LOGINS WITHIN 30 DAYS
-- No changes in this step
-- =========================================================================
CREATE OR REPLACE TABLE DEPT_410_PPM_AP_WORKSPACE_DB.FDLT.FREE_TO_PROV_LOGINS2 AS
SELECT
    C.USER_ID,
    C.USER_UID,
    C.CAMPAIGN_ID,
    C.START_DATE,
    COUNT(DISTINCT E.FOR_DATE) AS LOGIN_COUNT,
    MAX(CASE WHEN E.FOR_DATE IS NOT NULL THEN 1 ELSE 0 END) AS HAD_LOGIN,
    MIN(E.FOR_DATE) AS FIRST_LOGIN_DATE,
    MIN(DATEDIFF(DAY, C.START_DATE, E.FOR_DATE)) AS DAYS_TO_FIRST_LOGIN
FROM DEPT_410_PPM_AP_WORKSPACE_DB.FDLT.FREE_TO_PROV_COHORTS_FILTERED2 C
LEFT JOIN USAGE.USER_FEATURE_USAGE_DAILY E
    ON C.USER_ID = E.USER_ID
    AND E.FOR_DATE > DATE(C.START_DATE)
    AND E.FOR_DATE <= DATEADD(DAY, 30, DATE(C.START_DATE))
    AND E.COUNT_ALL_SOURCES > 0
GROUP BY 1, 2, 3, 4;


-- =========================================================================
-- STEP 7: TRACK ENGAGEMENT METRICS WITHIN 30 DAYS
-- No changes — window remains full 30 days per client confirmation
-- =========================================================================
CREATE OR REPLACE TABLE DEPT_410_PPM_AP_WORKSPACE_DB.FDLT.FREE_TO_PROV_ENGAGEMENT2 AS
SELECT
    C.USER_ID,
    C.USER_UID,
    C.CAMPAIGN_ID,
    C.START_DATE,
    SUM(CASE WHEN E.FEATURE_NAME LIKE '%Comment%' THEN E.COUNT_ALL_SOURCES ELSE 0 END)                                           AS COMMENT_COUNT,
    MAX(CASE WHEN E.FEATURE_NAME LIKE '%Comment%' AND E.COUNT_ALL_SOURCES > 0 THEN 1 ELSE 0 END)                                 AS HAD_COMMENT,
    SUM(CASE WHEN E.FEATURE_NAME LIKE '%Create%' THEN E.COUNT_ALL_SOURCES ELSE 0 END)                                            AS CREATE_COUNT,
    MAX(CASE WHEN E.FEATURE_NAME LIKE '%Create%' AND E.COUNT_ALL_SOURCES > 0 THEN 1 ELSE 0 END)                                  AS HAD_CREATE,
    SUM(E.COUNT_ALL_SOURCES)                                                                                                      AS TOTAL_ENGAGEMENT_COUNT,
    SUM(CASE WHEN E.FEATURE_NAME LIKE '%Comment%' AND E.FEATURE_NAME NOT LIKE '%Reply%' THEN E.COUNT_ALL_SOURCES ELSE 0 END)     AS CREATE_COMMENT_NEW_COUNT,
    MAX(CASE WHEN E.FEATURE_NAME LIKE '%Comment%' AND E.FEATURE_NAME NOT LIKE '%Reply%' AND E.COUNT_ALL_SOURCES > 0 THEN 1 ELSE 0 END) AS HAD_CREATE_COMMENT_NEW,
    SUM(CASE WHEN E.FEATURE_NAME LIKE '%Comment%' AND E.FEATURE_NAME LIKE '%Reply%' THEN E.COUNT_ALL_SOURCES ELSE 0 END)         AS CREATE_COMMENT_REPLY_COUNT,
    MAX(CASE WHEN E.FEATURE_NAME LIKE '%Comment%' AND E.FEATURE_NAME LIKE '%Reply%' AND E.COUNT_ALL_SOURCES > 0 THEN 1 ELSE 0 END) AS HAD_CREATE_COMMENT_REPLY,
    SUM(CASE WHEN E.FEATURE_NAME LIKE '%Create%' AND E.FEATURE_NAME LIKE '%Sheet%' THEN E.COUNT_ALL_SOURCES ELSE 0 END)          AS CREATE_SHEET_COUNT,
    MAX(CASE WHEN E.FEATURE_NAME LIKE '%Create%' AND E.FEATURE_NAME LIKE '%Sheet%' AND E.COUNT_ALL_SOURCES > 0 THEN 1 ELSE 0 END) AS HAD_CREATE_SHEET,
    SUM(CASE WHEN E.FEATURE_NAME LIKE '%Create%' AND E.FEATURE_NAME LIKE '%Workspace%' THEN E.COUNT_ALL_SOURCES ELSE 0 END)      AS CREATE_WORKSPACE_COUNT,
    MAX(CASE WHEN E.FEATURE_NAME LIKE '%Create%' AND E.FEATURE_NAME LIKE '%Workspace%' AND E.COUNT_ALL_SOURCES > 0 THEN 1 ELSE 0 END) AS HAD_CREATE_WORKSPACE
FROM DEPT_410_PPM_AP_WORKSPACE_DB.FDLT.FREE_TO_PROV_COHORTS_FILTERED2 C
LEFT JOIN USAGE.USER_FEATURE_USAGE_DAILY E
    ON C.USER_ID = E.USER_ID
    AND E.FOR_DATE > DATE(C.START_DATE)
    AND E.FOR_DATE <= DATEADD(DAY, 30, DATE(C.START_DATE))
GROUP BY 1, 2, 3, 4;


-- =========================================================================
-- STEP 8: FINAL TABLE
-- CHANGE 5: Simplified trigger columns from Step 5D
--           Added ADMIN_PROMOTED_TO_MEMBER flag
-- =========================================================================
CREATE OR REPLACE TABLE DEPT_410_PPM_AP_WORKSPACE_DB.FDLT.FREE_TO_PROV_FINAL2 AS
SELECT
    C.USER_ID,
    C.USER_UID,
    C.START_DATE,
    C.CAMPAIGN_ID,
    C.PRIMARY_ATTRIBUTE_VALUE,
    C.CAMPAIGN_ID_FRIENDLY,
    C.ACTIVITY_TYPE_ID,
    C.ACTIVITY_NAME,
    C.EMAIL_ADDRESS,
    C.USER_TYPE_AT_SEND,
    C.PLAN_ID,
    C.PLAN_UID,
    C.PRODUCT_NAME_AT_SEND,
    C.DOMAIN_TYPE,
    C.DOMAIN,
    C.COMPANY_SIZE,
    C.COMPANY_SIZE_RANGE,
    C.SMARTSHEET_INSTANCE,
    C.HAS_CS_REP,
    C.SUPPORT_TYPE,
    C.STILL_LICENSED,
    C.IS_USER_SUBSCRIPTION_MODEL,
    C.LANGUAGE,
    C.HVT,

    -- Login metrics
    COALESCE(L.HAD_LOGIN, 0)   AS HAD_LOGIN,
    COALESCE(L.LOGIN_COUNT, 0) AS LOGIN_COUNT,
    L.FIRST_LOGIN_DATE,
    L.DAYS_TO_FIRST_LOGIN,

    -- Provisional conversion
    CASE WHEN PC.USER_ID IS NOT NULL THEN 1 ELSE 0 END AS BECAME_PROVISIONAL,
    PC.PROVISIONAL_DATE,
    PC.DAYS_TO_PROVISIONAL,

    -- Member conversion
    CASE WHEN MC.USER_ID IS NOT NULL THEN 1 ELSE 0 END AS BECAME_MEMBER,
    MC.MEMBER_DATE,
    MC.DAYS_TO_MEMBER,

    -- Organic Member path (Provisional → Member)
    CASE
        WHEN PC.USER_ID IS NOT NULL
            AND MC.USER_ID IS NOT NULL
            AND MC.MEMBER_DATE >= PC.PROVISIONAL_DATE
        THEN 1
        ELSE 0
    END AS MEMBER_FROM_PROVISIONAL,

    -- Admin-promoted flag: became Member WITHOUT going through Provisional
    -- These users are excluded from trigger analysis
    CASE
        WHEN MC.USER_ID IS NOT NULL
            AND PC.USER_ID IS NULL
        THEN 1
        ELSE 0
    END AS ADMIN_PROMOTED_TO_MEMBER,

    -- Downgrade metrics
    CASE WHEN D.USER_ID IS NOT NULL THEN 1 ELSE 0 END AS WAS_DOWNGRADED,
    D.DOWNGRADE_DATE,
    D.DAYS_FROM_PROV_TO_DOWNGRADE,

    -- Trigger action columns (Step 5D)
    -- NULL for non-Provisional and Admin-promoted users
    -- 'Comment' for Campaign 55646 | 'Create' for Campaign 55647
    TA.TRIGGER_ACTION_TYPE,
    TA.TRIGGER_ACTION_DATE,
    TA.DAYS_TO_TRIGGER_ACTION,
    TA.HAD_TRIGGER_ACTION,

    -- Engagement metrics (full 30-day window)
    COALESCE(ENG.COMMENT_COUNT, 0)              AS COMMENT_COUNT,
    COALESCE(ENG.HAD_COMMENT, 0)                AS HAD_COMMENT,
    COALESCE(ENG.CREATE_COUNT, 0)               AS CREATE_COUNT,
    COALESCE(ENG.HAD_CREATE, 0)                 AS HAD_CREATE,
    COALESCE(ENG.TOTAL_ENGAGEMENT_COUNT, 0)     AS TOTAL_ENGAGEMENT_COUNT,
    COALESCE(ENG.CREATE_COMMENT_NEW_COUNT, 0)   AS CREATE_COMMENT_NEW_COUNT,
    COALESCE(ENG.HAD_CREATE_COMMENT_NEW, 0)     AS HAD_CREATE_COMMENT_NEW,
