ALTER TABLE DEPT_410_PPM_AP_WORKSPACE_DB.FDLT.FREE_TO_PROV_FINAL2
ADD COLUMN NEW_LOGO NUMBER(38,0);

UPDATE DEPT_410_PPM_AP_WORKSPACE_DB.FDLT.FREE_TO_PROV_FINAL2 AS A
SET A.NEW_LOGO = 1
FROM (
    SELECT
        A1.DOMAIN,
        MIN(COALESCE(ADP.START_MONTH, '9999-12-01')) AS NEW_LOGO_MONTH
    FROM DEPT_410_PPM_AP_WORKSPACE_DB.FDLT.FREE_TO_PROV_FINAL2 AS A1
    LEFT JOIN WORK.C_DUNN_ALL_DOMAINS_PURCHASED AS ADP
        ON A1.DOMAIN = ADP.DOMAIN
    WHERE A1.DOMAIN_TYPE = 'Org'
    GROUP BY 1
) AS B
WHERE
    A.BECAME_MEMBER = 1
    AND TO_VARCHAR(A.MEMBER_DATE, 'YYYY-MM') < TO_VARCHAR(B.NEW_LOGO_MONTH)
    AND A.DOMAIN = B.DOMAIN;

UPDATE DEPT_410_PPM_AP_WORKSPACE_DB.FDLT.FREE_TO_PROV_FINAL2
SET NEW_LOGO = 0
WHERE NEW_LOGO IS NULL;
