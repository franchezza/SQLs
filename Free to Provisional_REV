-- =========================================================================
-- STEP 2: GET USER TYPE AT TIME OF EMAIL SEND
-- No changes in this step
-- =========================================================================
CREATE OR REPLACE TABLE DEPT_410_PPM_AP_WORKSPACE_DB.FDLT.FREE_TO_PROV_USER_TYPE_AT_SEND2 AS
SELECT
    C.USER_ID,
    C.USER_UID,
    C.START_DATE,
    C.CAMPAIGN_ID,
    L.HIGHEST_USER_TYPE AS USER_TYPE_AT_SEND,
    L.JOURNAL_DATE_TIME AS USER_TYPE_DATE
FROM DEPT_410_PPM_AP_WORKSPACE_DB.FDLT.FREE_TO_PROV_COHORTS2 C
LEFT JOIN LEAD.MARKETO_SMARTSHEET_LEAD_COMBINED_J L
    ON C.USER_ID = L.USER_ID
    AND L.JOURNAL_DATE_TIME <= C.START_DATE
    AND L.JOURNAL_ACTION != 'DELETE'
WHERE L.HIGHEST_USER_TYPE IS NOT NULL
QUALIFY ROW_NUMBER() OVER (
    PARTITION BY C.USER_ID, C.CAMPAIGN_ID, C.START_DATE
    ORDER BY L.JOURNAL_DATE_TIME DESC
) = 1;


-- =========================================================================
-- STEP 3: FILTER COHORT TO ONLY GUEST/VIEWER/GHOST AT TIME OF SEND
-- CHANGE 2: Added 'Ghost' to WHERE clause
-- =========================================================================
CREATE OR REPLACE TABLE DEPT_410_PPM_AP_WORKSPACE_DB.FDLT.FREE_TO_PROV_COHORTS_FILTERED2 AS
SELECT
    C.*,
    UTS.USER_TYPE_AT_SEND
FROM DEPT_410_PPM_AP_WORKSPACE_DB.FDLT.FREE_TO_PROV_COHORTS2 C
INNER JOIN DEPT_410_PPM_AP_WORKSPACE_DB.FDLT.FREE_TO_PROV_USER_TYPE_AT_SEND2 UTS
    ON C.USER_ID = UTS.USER_ID
    AND C.CAMPAIGN_ID = UTS.CAMPAIGN_ID
    AND C.START_DATE = UTS.START_DATE
WHERE UTS.USER_TYPE_AT_SEND IN ('Guest', 'Viewer', 'Ghost');


-- =========================================================================
-- STEP 4: TRACK USER TYPE CHANGES WITHIN 30 DAYS OF EMAIL
-- No changes in this step
-- =========================================================================
CREATE OR REPLACE TABLE DEPT_410_PPM_AP_WORKSPACE_DB.FDLT.FREE_TO_PROV_USER_TYPE_CHANGES2 AS
SELECT
    C.USER_ID,
    C.USER_UID,
    C.CAMPAIGN_ID,
    C.START_DATE,
    C.USER_TYPE_AT_SEND,
    L.HIGHEST_USER_TYPE AS NEW_USER_TYPE,
    L.JOURNAL_DATE_TIME AS CHANGE_DATE,
    DATEDIFF(DAY, C.START_DATE, L.JOURNAL_DATE_TIME) AS DAYS_FROM_EMAIL
FROM DEPT_410_PPM_AP_WORKSPACE_DB.FDLT.FREE_TO_PROV_COHORTS_FILTERED2 C
INNER JOIN LEAD.MARKETO_SMARTSHEET_LEAD_COMBINED_J L
    ON C.USER_ID = L.USER_ID
WHERE
    L.JOURNAL_DATE_TIME > C.START_DATE
    AND L.JOURNAL_DATE_TIME <= DATEADD(DAY, 30, C.START_DATE)
    AND L.JOURNAL_ACTION != 'DELETE'
    AND L.HIGHEST_USER_TYPE != C.USER_TYPE_AT_SEND
ORDER BY C.USER_ID, L.JOURNAL_DATE_TIME;


-- =========================================================================
-- STEP 5A: FIRST PROVISIONAL CONVERSION
-- No changes in this step
-- =========================================================================
CREATE OR REPLACE TABLE DEPT_410_PPM_AP_WORKSPACE_DB.FDLT.FREE_TO_PROV_PROVISIONAL_CONVERSIONS2 AS
SELECT
    USER_ID,
    USER_UID,
    CAMPAIGN_ID,
    START_DATE,
    USER_TYPE_AT_SEND,
