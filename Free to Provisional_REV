    b.EMAIL_ADDRESS,
    g.PLAN_ID,
    g.PLAN_UID,
    g.PRODUCT_NAME_AT_SEND,
    g.DOMAIN_TYPE,
    g.DOMAIN,
    g.COMPANY_SIZE,
    g.COMPANY_SIZE_RANGE,
    g.SMARTSHEET_INSTANCE,
    g.HAS_CS_REP,
    g.SUPPORT_TYPE,
    g.STILL_LICENSED,
    g.IS_USER_SUBSCRIPTION_MODEL,
    g.LANGUAGE,
    g.HVT
FROM DEPT_410_PPM_AP_WORKSPACE_DB.HBEY.LMR145B_1_COHORTS g
INNER JOIN MARKETO.LEAD b
